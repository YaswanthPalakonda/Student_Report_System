# Copy this file to server/.env and replace every placeholder manually.
# Never commit server/.env or any real secret.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Replace <user>, <password>, <cluster-host>.
# Keep the database name either in the URI or in MONGODB_DB_NAME.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=student_report_system

# Generate with a cryptographically secure random source, at least 32 characters.
# Example command: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d

# Password hashing cost. 12 is the production default.
BCRYPT_ROUNDS=12

# Allowed frontend origin. In production with Vercel same-origin, set this to
# the exact deployment URL. Multiple origins may be comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# Proxy handling. Keep 1 behind Vercel or another reverse proxy; set 0 when the
# API is reached directly.
TRUST_PROXY=1

# Optional cookie override. Defaults to true when NODE_ENV=production and to
# false otherwise. Set explicitly only if you need to override that behavior.
# COOKIE_SECURE=true

# Optional: override Node's DNS resolvers with comma-separated IP addresses.
# Only needed in local environments where Node cannot read the system DNS
# configuration. Do not set this on Vercel.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Login rate limiting.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Initial admin account used only by `npm run seed:admin`.
# Use a unique email and a strong password of at least 12 characters.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-min-12-characters

# Optional: set to true ONLY when intentionally resetting the seeded admin
# password. The seed script never resets a password by default.
ADMIN_RESET_PASSWORD=false
